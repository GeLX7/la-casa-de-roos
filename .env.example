# Public site URL used for canonicals, OG metadata, sitemap, and iCal feed URLs.
NEXT_PUBLIC_SITE_URL=https://lacasaderoos.com

# Supabase placeholders. Do not commit real credentials. All three must come
# from the SAME Supabase project (Dashboard → Settings → API); a key from an
# older/recreated project produces "Invalid API key" errors in the admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Mode (username/password — no Supabase Auth). All four are required
# before /admin works; while ENABLE_ADMIN_ROUTES is not "true" every admin
# route redirects home. Generate the hash LOCALLY with
# `node scripts/hash-admin-password.mjs` (never commit the plaintext
# password) and the session secret with `openssl rand -base64 48`.
ENABLE_ADMIN_ROUTES=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Future: Airbnb calendar sync (iCal) -----------------------------------
# Not active yet. Availability is confirmed by WhatsApp until the owner
# provides the private Airbnb iCal export URLs. BOOKING_ICAL_SECRET
# protects the site's own .ics export feeds and is configured at the same
# time. See docs/architecture/booking-calendar-sync.md.
BOOKING_ICAL_SECRET=
AIRBNB_ICAL_ROOS_CORAZON=
AIRBNB_ICAL_ROOS_CENTRO=
AIRBNB_ICAL_ROOS_VISTA=
AIRBNB_ICAL_ROOS_FAMILIAR=
AIRBNB_ICAL_ROOS_MINI_CENTRO=

# Public catalog source. Leave empty (static) until Supabase is migrated,
# seeded, and verified; then set to "supabase" so the public site reads the
# owner-edited catalog. Static listings remain the automatic fallback.
CATALOG_DATA_SOURCE=

# No payment-provider or notification-email variables: payments stay on
# Airbnb and direct inquiries go through WhatsApp (owner decision, June 2026).
